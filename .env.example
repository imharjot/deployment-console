# ---- data sources -------------------------------------------------------------
# Which account the console reads: mock = a simulated AWS account (clusters, services, logs, CI) for trying the console;
# aws (exactly, lowercase) = your account + GitHub. Unset = an admin chooses in Settings → AWS connection (no restart),
# and until then the simulated account. Set, it decides and Settings shows it read-only; so do AWS_REGION, AWS_PROFILE
# (or keys) and CONSOLE_REGIONS, and CONSOLE_SOURCE=aws pins the sign-in to this environment's credentials too.
# Credentials: the standard chain (AWS_PROFILE, AWS_ACCESS_KEY_ID/…, a task role), or a profile or role chosen in
# Settings. The console never stores AWS keys.
# CONSOLE_SOURCE=
# The console's home region: ECS environments and global services are read here first. Unset = AWS_DEFAULT_REGION, then
# Settings' choice, then us-east-1.
# AWS_REGION=
# More regions to read, comma-separated (home is always included, first), or all-enabled (every region enabled in the
# account, asked daily). Unset = the config's inventory.regions, else the home region alone. At most 30.
# CONSOLE_REGIONS=
# Most AWS calls in flight at once across discovery, the cloud map and actions (1-256; each service also has a small
# per-region cap). GET /api/diagnostics/aws shows the queues.
# CONSOLE_AWS_CONCURRENCY=16
# CloudWatch metrics the cloud map may read per hour for idle marks (0 turns them off; $0.01 per 1,000).
# CONSOLE_ACTIVITY_BUDGET=5000
# Optional facts AWS can't tell (names, repos, external systems, hidden dependencies). Default ./console.config.json;
# the demo falls back to examples/demo.console.config.json. See docs/configuration.md.
CONSOLE_CONFIG=
# Org/user on GitHub used to match services to repos by name when they have no console:repo tag.
GITHUB_OWNER=
# The console's own ECS service as cluster/task-family (e.g. acme-tools/deployment-console). Recommended on ECS: without
# it the console refuses every change while the ECS task metadata endpoint doesn't answer.
# CONSOLE_SELF=
# Demo only: multiply the simulated log volume (e.g. 20 to load-test the log viewer).
# MOCK_LOG_RATE_MULT=1

# ---- cloud map --------------------------------------------------------------------
# Cloudflare zones on the map (optional). An API token with Zone:Read and DNS:Read on the zones to show (plus Cache Purge
# for the purge action); unset = Cloudflare is left off the map. Settings → AWS permissions lists the scopes. See
# docs/permissions.md.
CLOUDFLARE_API_TOKEN=
# Only this Cloudflare account's zones (optional; unset = every zone the token can read).
CLOUDFLARE_ACCOUNT_ID=
# EKS: also list workloads in kube-system, kube-public and kube-node-lease (default: skipped).
# CONSOLE_EKS_SYSTEM_NAMESPACES=false
# The console runs on a plain EC2 instance (not ECS): its instance id, so it never stops or reboots itself. Tagging the
# instance console:self=true does the same.
# CONSOLE_SELF_INSTANCE=

# ---- console database -----------------------------------------------------------
# Unset = SQLite under CONSOLE_DATA_DIR (one container with a persistent disk). Set postgres://… on Fargate.
DATABASE_URL=
CONSOLE_DATA_DIR=./data
# The SQLite file; defaults to $CONSOLE_DATA_DIR/console.db (":memory:" for a throwaway run).
# CONSOLE_SQLITE_PATH=
# ≥ 32 random characters; encrypts integration secrets, agents' approval inputs and SSO state. Generated into
# $CONSOLE_DATA_DIR/secret.key if unset; REQUIRED whenever DATABASE_URL is set (openssl rand -base64 48). Keep it stable.
CONSOLE_SECRET_KEY=

# ---- auth ---------------------------------------------------------------------
# session (default when unset) = users sign in (password and/or OIDC SSO); sessions live in the console DB.
# alb = an AWS ALB authenticate-oidc action signs users in; its x-amzn-oidc-data header is verified.
# dev = local only: a session cookie if present, else DEV_USER_EMAIL as an admin (refused when NODE_ENV=production).
AUTH_MODE=dev
DEV_USER_EMAIL=you@example.com
# First admin, used only while there are no users. Without these (and outside dev mode), the server log prints a
# one-time setup token and /setup creates the admin. A password must be at least 10 characters; without one, the
# admin can only sign in with SSO or through the ALB.
CONSOLE_ADMIN_EMAIL=
CONSOLE_ADMIN_PASSWORD=
# Public URL (https://console.example.com): OIDC redirect URI, invite links, Secure cookies. Defaults to the request origin.
CONSOLE_PUBLIC_URL=
# Session lifetime in hours, at most 720 (sliding; renewed at most every 10 min, never past 7 days from sign-in, or
# past the lifetime itself if you set it longer than 168).
SESSION_TTL_HOURS=12
# Email + password sign-in (session/dev modes). Set to false for SSO-only.
AUTH_PASSWORD_LOGIN=true
# Generic OIDC SSO (Google, Okta, Azure AD / Entra, Auth0, Keycloak…). Redirect URI: <public url>/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_LABEL=Sign in with SSO
# Refuse ID tokens whose email the provider hasn't verified (absent email_verified counts as unverified; Entra: add the
# xms_edov optional claim). false = only an explicit false is refused.
OIDC_REQUIRE_EMAIL_VERIFIED=true
# SSO/ALB users who weren't invited are auto-created only for these email domains (comma-separated), with this role
# (viewer | developer | operator; admin is never auto-granted). Invited users always keep their invited role.
AUTH_ALLOWED_DOMAINS=
AUTH_DEFAULT_ROLE=viewer
# alb mode, required: ARN of the ALB; headers signed by any other ALB are rejected (unset = every request refused).
ALB_ARN=
# alb mode, optional extra gate: only these emails (comma-separated), on top of the users table.
CONSOLE_ALLOWED_EMAILS=

# Proxies in front of the console that append X-Forwarded-For: 1 = one ALB or reverse proxy (default), 2 = CloudFront
# in front of an ALB, 0 = nothing in front (X-Forwarded-For is ignored; per-address sign-in limits switch off).
CONSOLE_TRUSTED_PROXIES=1

# ---- agents & API -------------------------------------------------------------
# API tokens let agents and scripts use the operations API (/api/ops) and the MCP endpoint (/api/mcp); people create
# them under Automation. false (exactly, lowercase) = refuse every token request and block new tokens.
# See docs/automation.md.
CONSOLE_API_TOKENS=true
# Agent platform (agent tokens, runs, the worker): on / off overrides the admin's toggle. Unset = the toggle, else on with
# the simulated account and off against a real AWS account. Any other value = off.
CONSOLE_AGENTS=
# true = nobody may approve requests made with their own API tokens (a second person must). Off by default.
CONSOLE_APPROVALS_TWO_PERSON=false
# Local runtimes: absolute paths of the claude (>= 2.1.263) and gemini (>= 0.11.0) CLIs, signed in as the user the
# console runs as (unset = found on PATH), and how many may run at once (1-16).
CONSOLE_CLAUDE_BIN=
CONSOLE_GEMINI_BIN=
CONSOLE_RUNTIME_CONCURRENCY=1
# eligible = allow ChatGPT-plan connections (only where OpenAI's plan-usage conditions are met: open-source or personal
# use, running locally; sign-in only on http://127.0.0.1:<port>). Unset = off. The CONSOLE_CHATGPT_ISSUER/_AUTHORIZE_URL/
# _TOKEN_URL/_REVOKE_URL/_JWKS_URL/_API_BASE overrides exist for a test provider only.
CONSOLE_CHATGPT_PLAN=

# ---- github -------------------------------------------------------------------
# Fine-grained token: Actions read/write, Contents read, Metadata read on the watched repos only.
GITHUB_TOKEN=
