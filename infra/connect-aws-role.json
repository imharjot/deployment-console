{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Lets one Deployment Console read this AWS account: a read-only IAM role that only that console's own login can switch into, and only with its external ID. No keys are created. Delete this stack to cut the console off.",
  "Metadata": {
    "AWS::CloudFormation::Interface": {
      "ParameterGroups": [
        {
          "Label": {
            "default": "The console that may connect (filled in by the console)"
          },
          "Parameters": [
            "TrustedAccountId",
            "TrustedPrincipalType",
            "TrustedPrincipalName",
            "ExternalId"
          ]
        },
        {
          "Label": {
            "default": "The role this stack creates"
          },
          "Parameters": [
            "RoleName"
          ]
        }
      ],
      "ParameterLabels": {
        "TrustedAccountId": {
          "default": "Console's AWS account"
        },
        "TrustedPrincipalType": {
          "default": "Console's login is a"
        },
        "TrustedPrincipalName": {
          "default": "Console's login name"
        },
        "ExternalId": {
          "default": "External ID"
        },
        "RoleName": {
          "default": "Role name"
        }
      }
    }
  },
  "Parameters": {
    "TrustedAccountId": {
      "Type": "String",
      "AllowedPattern": "^\\d{12}$",
      "ConstraintDescription": "a 12-digit AWS account ID",
      "Description": "The AWS account the console runs in."
    },
    "TrustedPrincipalType": {
      "Type": "String",
      "AllowedValues": [
        "role",
        "user"
      ],
      "Description": "Whether the console's own login is an IAM role (ECS task role, EC2 instance profile) or an IAM user."
    },
    "TrustedPrincipalName": {
      "Type": "String",
      "AllowedPattern": "^[\\w+=,.@-]{1,128}$",
      "ConstraintDescription": "an IAM role or user name, without its path",
      "Description": "The name of that role or user, without its path."
    },
    "ExternalId": {
      "Type": "String",
      "AllowedPattern": "^[\\w+=,.@:/-]{2,1224}$",
      "ConstraintDescription": "2 to 1224 letters, digits or +=,.@:/-",
      "Description": "The console's external ID: the role can only be switched into with it."
    },
    "RoleName": {
      "Type": "String",
      "Default": "deployment-console-access",
      "AllowedPattern": "^[\\w+=,.@-]{1,64}$",
      "ConstraintDescription": "1 to 64 letters, digits or +=,.@_-",
      "Description": "The name of the role to create."
    }
  },
