    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Ref": "RoleName"
        },
        "Description": "Read-only access for one Deployment Console. Delete the stack that made it to cut the console off.",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OnlyThisConsole",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${TrustedAccountId}:root"
                }
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                },
                "ArnLike": {
                  "aws:PrincipalArn": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${TrustedAccountId}:${TrustedPrincipalType}/${TrustedPrincipalName}"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:iam::${TrustedAccountId}:${TrustedPrincipalType}/*/${TrustedPrincipalName}"
                    }
                  ]
                }
              }
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Ref": "ReadOnlyPolicy1"
          },
          {
            "Ref": "ReadOnlyPolicy2"
          }
        ],
        "Tags": [
          {
            "Key": "created-by",
            "Value": "deployment-console"
          }
        ]
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "Paste this into the console: Settings, AWS connection, Switch into a role.",
      "Value": {
        "Fn::GetAtt": [
          "Role",
          "Arn"
        ]
      }
    },
    "ExternalId": {
      "Description": "The external ID the role expects.",
      "Value": {
        "Ref": "ExternalId"
      }
    }
  }
}
