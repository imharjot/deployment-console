{
  "family": "deployment-console",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/deployment-console-task",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/deployment-console-exec",
  "containerDefinitions": [
    {
      "name": "deployment-console",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/deployment-console:latest",
      "essential": true,
      "stopTimeout": 30,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "CONSOLE_SOURCE",
          "value": "aws"
        },
        {
          "name": "AWS_REGION",
          "value": "REGION"
        },
        {
          "name": "AUTH_MODE",
          "value": "session"
        },
        {
          "name": "CONSOLE_PUBLIC_URL",
          "value": "https://console.example.com"
        },
        {
          "name": "GITHUB_OWNER",
          "value": "your-org"
        },
        {
          "name": "CONSOLE_SELF",
          "value": "CONSOLE_CLUSTER/deployment-console"
        },
        {
          "name": "NEXT_MANUAL_SIG_HANDLE",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/deployment-console/DATABASE_URL"
        },
        {
          "name": "CONSOLE_SECRET_KEY",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/deployment-console/CONSOLE_SECRET_KEY"
        },
        {
          "name": "GITHUB_TOKEN",
          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/deployment-console/GITHUB_TOKEN"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:3000/api/healthz >/dev/null || exit 1"
        ],
        "interval": 15,
        "timeout": 3,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/deployment-console",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
