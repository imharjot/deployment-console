{
  "name": "deployment-console",
  "version": "0.1.0",
  "description": "Self-hosted console for teams on Amazon ECS: discovers environments, services, databases and their connections, with status, logs, metrics, CI, guarded actions, sign-in and roles.",
  "keywords": [
    "aws",
    "ecs",
    "fargate",
    "devops",
    "deployment",
    "dashboard",
    "observability",
    "cloudwatch",
    "github-actions",
    "internal-tools",
    "nextjs"
  ],
  "homepage": "https://github.com/imharjot/deployment-console#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imharjot/deployment-console.git"
  },
  "bugs": {
    "url": "https://github.com/imharjot/deployment-console/issues"
  },
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --test-reporter=spec \"src/**/*.test.ts\"",
    "test:pg": "node scripts/pg-test.mjs",
    "iam:policy": "node --conditions=react-server scripts/iam-policy.mjs",
    "smoke": "node scripts/smoke.mjs",
    "parity": "node scripts/parity.mjs"
  },
